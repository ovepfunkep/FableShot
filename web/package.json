{
  "name": "fableshot-web",
  "private": true,
  "version": "0.30.6",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "androidVersionCode": 50
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
